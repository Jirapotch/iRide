    "@iride/types": "workspace:*",
    "@iride/validation": "workspace:*",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsup": "^8.5.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
