{
  "name": "@iride/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate:show": "tsx scripts/typeorm-migrations.ts show",
    "db:migrate:run": "tsx scripts/typeorm-migrations.ts run",
    "db:migrate:revert": "tsx scripts/typeorm-migrations.ts revert",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@iride/auth": "workspace:*",
    "@iride/config": "workspace:*",
    "@iride/database": "workspace:*",
    "@iride/domain": "workspace:*",
    "@iride/storage": "workspace:*",
    "@iride/types": "workspace:*",
    "@iride/validation": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
