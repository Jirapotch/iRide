{
  "name": "iride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/web.mjs dev",
    "build": "pnpm --filter @iride/web build",
    "start": "node --env-file-if-exists=.env.local scripts/web.mjs start",
    "lint": "pnpm --filter @iride/web lint && eslint scripts tests eslint.config.mjs playwright.config.ts",
    "typecheck": "pnpm --filter @iride/web typecheck",
    "test": "pnpm --filter @iride/web test && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "drive:setup": "node --env-file-if-exists=.env.local scripts/setup-google-drive.mjs",
    "db:cutover": "node --env-file-if-exists=.env.cutover.local scripts/production-cutover.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "2.112.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.1",
    "pg": "8.23.1",
    "prettier": "^3.6.2",
    "supabase": "2.115.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
