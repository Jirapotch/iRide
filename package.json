{
  "name": "iride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/turbo/bin/turbo run dev",
    "build": "turbo run build",
    "db:advisors": "supabase db advisors --local --type all --fail-on error",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db --local",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/check-database-types.mjs",
    "lint": "turbo run lint && eslint scripts eslint.config.mjs playwright.config.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.6.2",
    "supabase": "2.115.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
