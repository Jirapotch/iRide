# Local Supabase: run pnpm db:start, copy values from supabase status.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only Google OAuth setup; never expose these via NEXT_PUBLIC_ variables.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=1mFCIBIJHkQjYn4y_gg0GRkiELEatHMf0
# OAuth/Picker setup tool only; Google Cloud project NUMBER, not ID.
GOOGLE_DRIVE_PROJECT_NUMBER=
GOOGLE_DRIVE_PICKER_API_KEY=

# Production cutover is separate; put these in ignored .env.cutover.local.
