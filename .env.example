# Public application configuration (safe for browser bundles)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_MAPTILER_KEY=your-browser-maptiler-key

# API configuration (server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase CLI local Google OAuth provider (server-only)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-web-client-secret

# Cloudflare R2 (server-only; never add NEXT_PUBLIC_ prefixes)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=iride

# Opn Payments (server-only)
OPN_SECRET_KEY=skey_test_your-secret-key
OPN_WEBHOOK_SECRET=your-webhook-secret

# Runtime overrides
APP_VERSION=0.1.0
WORKER_PORT=3002
